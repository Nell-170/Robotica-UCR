{"identifier":"cb69ec96-03af-4d42-8dcc-7945ace6da39","name":"Luz Explorador","summary":"","data":"15;python&async def start_program():\n    velocidad_normal = 50\n    velocidad_lenta = 20\n    limite_luz = 30\n    rumbos = [0, 90, 180, 270]\n    indice = 0\n\n    while True:\n        luz = get_ambient_light()\n\n        if luz >= limite_luz:\n\n            # Rojo = ¡tiene miedo!\n            set_main_led({\"r\": 255, \"g\": 0, \"b\": 0})\n\n            # Girar 180° (relativo) y escapar de la luz, pero lento\n            heading_actual = get_heading()\n            set_heading((heading_actual + 180) % 360)\n            set_speed(velocidad_lenta)\n\n            # Huir mientras haya luz\n            while get_ambient_light() >= limite_luz:\n                await delay(0.2)\n\n            set_speed(0)\n\n        else:\n            # Verde = explorando zona segura, despacito\n            set_main_led({\"r\": 0, \"g\": 255, \"b\": 0})\n\n            # Elegir el siguiente rumbo de forma cíclica (sin random)\n            nuevo_rumbo = rumbos[indice]\n            indice = (indice + 1) % len(rumbos)\n\n            set_heading(nuevo_rumbo)\n            set_speed(velocidad_lenta)\n\n            # Avanzar un tramo lento, revisando que no haya luz\n            for _ in range(5):\n                if get_ambient_light() >= limite_luz:\n                    break\n                await delay(0.2)\n\n            set_speed(0)\n\n        await delay(0.2)","modified_on":"2026-10-05T15:11:27.3359000-06:00","program_type":"text","robots":[{"id":9}]}