{"identifier":"f5c465e2-5c50-4298-b395-166f8227fc51","name":"Luz Amoroso","summary":"","data":"15;python&async def start_program():\n    velocidad = 50\n    limite_luz = 30\n\n    while True:\n        luz = get_ambient_light()\n\n        if luz >= limite_luz:\n\n            # Rojo = ¡tiene miedo!\n            set_main_led({\"r\": 255, \"g\": 0, \"b\": 0})\n\n            # Girar 180° y escapar de la luz\n            heading_actual = get_heading()\n            set_heading((heading_actual + 180) % 360)\n            velocidad = 20\n            set_speed(velocidad)\n\n            # Huir mientras haya luz\n            while get_ambient_light() >= limite_luz:\n                await delay(0.2)\n\n            # Ya no hay luz, detenerse\n            set_speed(0)\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n\n        else:\n            # Está oscuro, zona segura\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n            set_speed(0)\n\n        await delay(0.2)","modified_on":"2026-10-05T15:42:38.5687000-06:00","program_type":"text","robots":[{"id":9}]}