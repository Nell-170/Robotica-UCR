{"identifier":"fd084cfe-b6d0-4f28-b904-2351c8614fe8","name":"Programa sin título","summary":"","data":"15;python&async def start_program():\n    velocidad = 50\n    limite_luz = 30\n\n    while True:\n        luz = get_ambient_light()\n\n        if luz >= limite_luz:\n\n            # Rojo = ¡tiene miedo!\n            set_main_led({\"r\": 255, \"g\": 0, \"b\": 0})\n\n            # Girar 180° y escapar de la luz\n            heading_actual = get_heading()\n            set_heading((heading_actual) % 360)\n            velocidad = 150\n            set_speed(velocidad)\n\n            # Huir mientras haya luz\n            while get_ambient_light() >= limite_luz:\n                await delay(0.2)\n\n            # Ya no hay luz, detenerse\n            set_speed(0)\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n\n        else:\n            # Está oscuro, zona segura\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n            set_speed(0)\n\n        await delay(0.2)","modified_on":"2026-10-05T13:31:22.7428000-06:00","program_type":"text","robots":[{"id":9}]}