{"identifier":"00a44224-e626-418d-bbb7-6608bb9b03b9","name":"Luz agresivo","summary":"","data":"15;python&async def start_program():\n    velocidad = 50\n    limite_luz = 30\n\n    while True:\n\n        # Buscar la dirección con más luz\n        mayor_luz = 0\n        mejor_rumbo = 0\n\n        for rumbo in [0, 45, 90, 135, 180, 225, 270, 315]:\n\n            set_speed(0)\n            set_heading(rumbo)\n            await delay(0.2)\n\n            luz = get_ambient_light()\n\n            if luz > mayor_luz:\n                mayor_luz = luz\n                mejor_rumbo = rumbo\n\n        # Si encuentra suficiente luz\n        if mayor_luz >= limite_luz:\n\n            # Rojo = ¡modo agresivo!\n            set_main_led({\"r\": 255, \"g\": 0, \"b\": 0})\n\n            # Corrige el desfase de 180° entre sensor y frente del robot\n            rumbo_corregido = (mejor_rumbo) % 360\n\n            set_heading(rumbo_corregido)\n            set_speed(velocidad)\n\n            # Avanzar mientras haya luz\n            while get_ambient_light() >= limite_luz:\n                await delay(0.2)\n\n            set_speed(0)\n\n        else:\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n            set_speed(0)\n\n        await delay(0.2)","modified_on":"2026-10-05T14:40:46.3025000-06:00","program_type":"text","robots":[{"id":9}]}