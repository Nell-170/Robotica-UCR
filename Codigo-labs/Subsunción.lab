{"identifier":"42c4e01b-1378-4289-8c35-7ee3c0ec9984","name":"Subsunción","summary":"","data":"15;python&\nasync def start_program():\n    velocidad = 100\n    distancia_segura = 40\n    distancia_colision = 10\n    limite_luz = 60\n    lado_escape = 1\n\n    while True:\n\n        # Leer los sensores\n        luz = get_ambient_light()\n        distancia = get_distance()\n\n        # PRIORIDAD 1: BUSCAR LUZ\n        # AMARILLO\n\n        if luz >= limite_luz:\n            set_speed(0)\n            set_main_led({\"r\": 255, \"g\": 255, \"b\": 0})\n\n            rumbo = get_heading()\n\n            # Medir la luz a la izquierda\n            set_heading((rumbo - 45) % 360)\n            await delay(0.3)\n            luz_izquierda = get_ambient_light()\n\n            # Medir la luz a la derecha\n            set_heading((rumbo + 45) % 360)\n            await delay(0.3)\n            luz_derecha = get_ambient_light()\n\n            # Elegir la dirección con más luz\n            if luz_izquierda > luz_derecha:\n                set_heading((rumbo - 45) % 360)\n            else:\n                set_heading((rumbo + 45) % 360)\n\n            set_speed(velocidad)\n            await delay(0.5)\n            set_speed(0)\n\n        # PRIORIDAD 2: ESCAPAR DE UN OBSTÁCULO\n        # ROJO: menos de 10 cm\n\n        elif distancia < distancia_colision:\n            set_speed(0)\n            set_main_led({\"r\": 255, \"g\": 0, \"b\": 0})\n\n            if lado_escape == 1:\n                set_heading((get_heading() + 135) % 360)\n            else:\n                set_heading((get_heading() - 135) % 360)\n\n            await delay(0.3)\n\n            set_speed(40)\n            await delay(0.5)\n            set_speed(0)\n\n            lado_escape = lado_escape * -1\n\n        # PRIORIDAD 3: EVITAR OBSTÁCULOS\n        # BLANCO: entre 10 y 40 cm\n\n        elif distancia < distancia_segura and distancia >= distancia_colision:\n            set_speed(0)\n            set_main_led({\"r\": 255, \"g\": 255, \"b\": 255})\n\n            rumbo = get_heading()\n\n            # Medir la distancia a la izquierda\n            set_heading((rumbo - 90) % 360)\n            await delay(0.3)\n            izquierda = get_distance()\n\n            # Medir la distancia a la derecha\n            set_heading((rumbo + 90) % 360)\n            await delay(0.3)\n            derecha = get_distance()\n\n            # Elegir el lado con más espacio\n            if izquierda > derecha:\n                set_heading((rumbo - 90) % 360)\n            else:\n                set_heading((rumbo + 90) % 360)\n\n            # Avanzar para evitar el obstáculo\n            set_speed(40)\n            await delay(0.5)\n            set_speed(0)\n\n        # PRIORIDAD 4: AVANZAR\n        # AZUL: camino libre\n\n        else:\n            set_main_led({\"r\": 0, \"g\": 0, \"b\": 255})\n            set_speed(velocidad)\n            await delay(0.2)\n","modified_on":"2026-10-05T16:03:13.2642000-06:00","program_type":"text","robots":[{"id":9}]}